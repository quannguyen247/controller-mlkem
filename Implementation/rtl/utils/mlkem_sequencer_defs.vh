`ifndef MLKEM_SEQUENCER_DEFS
`define MLKEM_SEQUENCER_DEFS

`define MLKEM_SET_WIDTH 2
`define MLKEM_SET_512 2'b00
`define MLKEM_SET_768 2'b01
`define MLKEM_SET_1024 2'b10

`define MLKEM_OPERATION_WIDTH 2
`define MLKEM_OPERATION_KEYGEN 2'b00
`define MLKEM_OPERATION_ENCAPS 2'b01
`define MLKEM_OPERATION_DECAPS 2'b10

`define MLKEM_CMD_WIDTH 5
`define MLKEM_CMD_HASH_G 5'd0
`define MLKEM_CMD_HASH_H 5'd1
`define MLKEM_CMD_HASH_J 5'd2
`define MLKEM_CMD_SAMPLE_MATRIX 5'd3
`define MLKEM_CMD_SAMPLE_CBD 5'd4
`define MLKEM_CMD_NTT 5'd5
`define MLKEM_CMD_INTT 5'd6
`define MLKEM_CMD_BASEMUL_ACC 5'd7
`define MLKEM_CMD_ADD 5'd8
`define MLKEM_CMD_SUB 5'd9
`define MLKEM_CMD_ENCODE 5'd10
`define MLKEM_CMD_DECODE 5'd11
`define MLKEM_CMD_COMPRESS 5'd12
`define MLKEM_CMD_DECOMPRESS 5'd13
`define MLKEM_CMD_MESSAGE_TO_POLY 5'd14
`define MLKEM_CMD_POLY_TO_MESSAGE 5'd15
`define MLKEM_CMD_PACK 5'd16
`define MLKEM_CMD_COMPARE 5'd17
`define MLKEM_CMD_SELECT 5'd18
`define MLKEM_CMD_OUTPUT 5'd19

`define MLKEM_OBJECT_WIDTH 4
`define MLKEM_OBJECT_A 4'd0
`define MLKEM_OBJECT_S 4'd1
`define MLKEM_OBJECT_E 4'd2
`define MLKEM_OBJECT_T 4'd3
`define MLKEM_OBJECT_Y 4'd4
`define MLKEM_OBJECT_E1 4'd5
`define MLKEM_OBJECT_E2 4'd6
`define MLKEM_OBJECT_U 4'd7
`define MLKEM_OBJECT_V 4'd8
`define MLKEM_OBJECT_M 4'd9
`define MLKEM_OBJECT_W 4'd10
`define MLKEM_OBJECT_EK 4'd11
`define MLKEM_OBJECT_DK 4'd12
`define MLKEM_OBJECT_C 4'd13
`define MLKEM_OBJECT_K 4'd14
`define MLKEM_OBJECT_TEMP 4'd15

`define MLKEM_FLAG_TRANSPOSE 4'b0001
`define MLKEM_FLAG_ACCUMULATE 4'b0010
`define MLKEM_FLAG_REENCRYPT 4'b0100

`endif
